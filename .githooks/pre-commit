#!/bin/sh
# Pre-commit: GATE the commit on the four type programs (types/tsconfig*.json —
# the internal surface + fixtures, classic JSX, automatic JSX, and the SHIPPED
# public.d.ts consumer gate) whenever a TS source / fixture / tsconfig /
# package.json is staged. Same gate CI enforces — no "passed local, failed CI"
# surprises. Bypass with: git commit --no-verify
#
# The unit suite + perf gates run per the working conventions (npm test /
# npm run perf before committing behavior changes) — not here, to keep the
# hook fast.

staged=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$staged" | grep -qE '\.tsx?$|tsconfig.*\.json$|package\.json$'; then
  if command -v npm >/dev/null 2>&1; then
    echo "[typecheck] the four type programs (npm run typecheck)…"
    out=$(npm run --silent typecheck 2>&1)
    if [ $? -ne 0 ]; then
      echo "[typecheck] ✗ type errors — commit blocked:"
      echo "$out" | grep -E 'error TS' | head -20
      echo "[typecheck] (bypass with git commit --no-verify)"
      exit 1
    fi
    echo "[typecheck] ✓ clean"
  fi
fi

exit 0
