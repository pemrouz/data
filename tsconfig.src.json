{
  // IMPLEMENTATION type-check gate — the whole shipped library under `strict`.
  //
  // The @ts-nocheck retirement is COMPLETE: every implementation file (core,
  // all 16 operators, row, render, the full devtools layer, utils, register,
  // the entry files) is off `@ts-nocheck` and listed below. This config sets
  // `noCheck:false` and CI runs it BLOCKING (it was a non-blocking ratchet,
  // grown one migrated file at a time, during the migration). The root
  // tsconfig no longer sets `noCheck`, so the implementation is also checked by
  // default in an editor.
  //
  // Keep this list in sync when adding an implementation file. (`*.d.ts` like
  // jsx/jsx.d.ts are pulled in automatically via imports; only implementation
  // `.ts` files need listing. Test/perf tooling files keep a local @ts-nocheck
  // and are intentionally excluded.)
  "extends": "./tsconfig.json",
  "compilerOptions": { "noCheck": false, "noEmit": true, "skipLibCheck": true, "lib": ["ESNext", "DOM"] },
  "include": [
    "core.ts",
    "utils.ts",
    "register.ts",
    "index.ts",
    "lean.ts",
    "full.ts",
    "row.ts",
    "render/index.ts",
    "jsx/index.ts",
    "jsx/intrinsics.ts",
    "jsx-runtime.ts",
    "jsx-dev-runtime.ts",
    "devtools/augment.ts",
    "devtools/walk.ts",
    "devtools/events.ts",
    "devtools/instrument.ts",
    "devtools/index.ts",
    "devtools/panel/index.ts",
    "operators/map/index.ts",
    "operators/keys/index.ts",
    "operators/reverse/index.ts",
    "operators/to/index.ts",
    "operators/compare/index.ts",
    "operators/filter/index.ts",
    "operators/tap/index.ts",
    "operators/distinct/index.ts",
    "operators/length/index.ts",
    "operators/aggregate/index.ts",
    "operators/group/index.ts",
    "operators/union/index.ts",
    "operators/except/index.ts",
    "operators/intersect/index.ts",
    "operators/sort/index.ts",
    "operators/between/index.ts",
    "operators/reduce/index.ts"
  ]
}
